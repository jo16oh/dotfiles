#!/bin/sh

USAGE="Usage: dotfiles [install | upgrade | apply | dev | prune]"

if [ $# -lt 1 ]; then
    echo "$USAGE"
    exit 1
fi

COMMAND=$1

dotfiles_repo_dir=$(git -C "$(dirname "$(realpath "$0")")" rev-parse --show-toplevel)

case "$COMMAND" in
    "path")
        echo ${dotfiles_repo_dir}
        ;;
    "install")
        brew bundle install --file="${dotfiles_repo_dir}/Brewfile"
        mise install
        ;;
    
    "upgrade")
        brew upgrade
        mise upgrade
        ;;

    "apply")
        stow -v --restow --dotfiles --dir="$dotfiles_repo_dir" --target=$(echo ~) config
        ;;

    "dev")
        watchexec --watch "$dotfiles_repo_dir" "$0 apply"
        ;;

    "prune")
        brew bundle cleanup --force --file="${dotfiles_repo_dir}/Brewfile"
        mise prune
        ;;

    *)
        echo "Error: Unknown command '$COMMAND'"
        echo "$USAGE"
        exit 1
        ;;
esac
