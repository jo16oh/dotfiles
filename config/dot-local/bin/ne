#!/bin/sh
# Node tool executor agnostic to package managers

# Parse arguments to separate package manager options, command, and command arguments
pm_opts=""
command=""
cmd_args=""
found_command=false

for arg in "$@"; do
    if [ "$found_command" = true ]; then
        # After command: these are command arguments
        cmd_args="$cmd_args $arg"
    elif [ "${arg#-}" = "$arg" ]; then
        # First non-option argument is the command
        command="$arg"
        found_command=true
    else
        # Before command: these are package manager options
        pm_opts="$pm_opts $arg"
    fi
done

# If no command found, exit with error
if [ -z "$command" ]; then
    echo "Error: No command specified." >&2
    echo "Usage: ne [options] <command> [args...]" >&2
    exit 1
fi

current_dir="$(pwd)"
project_root=""
pm=""

while [ "$current_dir" != "/" ]; do
    # Check for Deno project
    if [ -f "$current_dir/deno.lock" ] || [ -f "$current_dir/deno.json" ] || [ -f "$current_dir/deno.jsonc" ]; then
        echo "Error: This is a Deno project. The 'ne' command does not support Deno." >&2
        echo "Please use 'deno x' directly instead." >&2
        exit 1
    # Check for pnpm
    elif [ -f "$current_dir/pnpm-lock.yaml" ]; then
        project_root="$current_dir"
        pm="pnpm"
        break
    # Check for bun
    elif [ -f "$current_dir/bun.lockb" ] || [ -f "$current_dir/bun.lock" ]; then
        project_root="$current_dir"
        pm="bun"
        break
    # Check for yarn
    elif [ -f "$current_dir/yarn.lock" ]; then
        project_root="$current_dir"
        pm="yarn"
        break
    # Check for npm
    elif [ -f "$current_dir/package-lock.json" ]; then
        project_root="$current_dir"
        pm="npm"
        break
    fi

    current_dir="$(dirname "$current_dir")"
done

if [ -z "$pm" ]; then
    echo "Error: No package manager lock file found." >&2
    echo "Supported files: pnpm-lock.yaml, bun.lockb, bun.lock, yarn.lock, package-lock.json" >&2
    exit 1
fi

# Skip the package manager CLI's own startup/resolution cost (pnpm exec in
# particular) by execing a locally-hoisted node_modules/.bin/<command> shim
# directly when one exists, walking up from cwd to the project root. Only
# safe when no pm-specific options were given, since those are meaningful to
# the pm's exec subcommand but not to the shim itself.
if [ -z "$pm_opts" ]; then
    search_dir="$(pwd)"
    while :; do
        if [ -x "$search_dir/node_modules/.bin/$command" ]; then
            exec "$search_dir/node_modules/.bin/$command" $cmd_args
        fi
        [ "$search_dir" = "$project_root" ] && break
        parent="$(dirname "$search_dir")"
        [ "$parent" = "$search_dir" ] && break
        search_dir="$parent"
    done
fi

case "$pm" in
    pnpm) exec pnpm $pm_opts exec -- $command $cmd_args ;;
    bun) exec bun $pm_opts x --no-install -- $command $cmd_args ;;
    yarn) exec yarn $pm_opts exec -- $command $cmd_args ;;
    npm) exec npm $pm_opts exec --no-install -- $command $cmd_args ;;
esac
