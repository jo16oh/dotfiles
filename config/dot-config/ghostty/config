font-size = 18
font-feature = -dlig
font-family = UDEV Gothic 35NFLG
adjust-cell-height = 10%
window-save-state = always
theme = everforest-dark-medium-gogh
bold-is-bright = true
cursor-opacity = 0.35
macos-option-as-alt = true
window-colorspace = display-p3

keybind = ctrl+t>s=new_split:down
keybind = ctrl+t>v=new_split:right
keybind = ctrl+t>o=toggle_split_zoom
keybind = cmd+shift+s=new_split:down
keybind = cmd+shift+v=new_split:right
keybind = ctrl+t>h=goto_split:left
keybind = ctrl+t>j=goto_split:bottom
keybind = ctrl+t>k=goto_split:top
keybind = ctrl+t>l=goto_split:right
keybind = cmd+shift+h=resize_split:left,20
keybind = cmd+shift+j=resize_split:down,20
keybind = cmd+shift+k=resize_split:up,20
keybind = cmd+shift+l=resize_split:right,20
